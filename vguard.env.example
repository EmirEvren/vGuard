# v-Guard environment example
# Copy to .env or configure these variables in your shell/runner.

# Development or production
VGUARD_ENV=production

# Required in production. Recommended in all modes.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VGUARD_SECRET_KEY=change-this-long-random-secret

# Use secure cookies only behind HTTPS.
# Set 1 in production behind HTTPS.
VGUARD_COOKIE_SECURE=1

# Session lifetime in minutes.
VGUARD_SESSION_MINUTES=30

# Credentialed CORS origin whitelist.
# Add your DigitalOcean domain/origin here.
VGUARD_CORS_ORIGINS=https://your-domain.example,http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5173,http://localhost:5173

# Dashboard API CSRF header guard.
VGUARD_DASHBOARD_CSRF=1

# Flask debug mode. Keep 0 unless actively debugging locally.
VGUARD_DEBUG=0

# Optional integrations
# GEMINI_API_KEY=

# Password reset mail: Google Apps Script sender.
# Deploy the Apps Script web app from demo.vguardips@gmail.com.
VGUARD_MAIL_METHOD=apps_script
VGUARD_MAIL_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwl4NYsousWUO7fY2CdITXSgJeTwil1Ypwsj8AzdS452fDEadFpg5fHbVZ5HfbPYAU8dg/exec
VGUARD_MAIL_SCRIPT_DEPLOYMENT_ID=AKfycbwl4NYsousWUO7fY2CdITXSgJeTwil1Ypwsj8AzdS452fDEadFpg5fHbVZ5HfbPYAU8dg
VGUARD_RESET_FROM=demo.vguardips@gmail.com

# Optional SMTP fallback. Use only if you set VGUARD_MAIL_METHOD=smtp.
# VGUARD_SMTP_HOST=smtp.gmail.com
# VGUARD_SMTP_PORT=587
# VGUARD_SMTP_USERNAME=demo.vguardips@gmail.com
# VGUARD_SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
# VGUARD_SMTP_FROM=demo.vguardips@gmail.com
# VGUARD_SMTP_TLS=1

# CSV download safety caps.
VGUARD_CSV_MAX_MB=100
VGUARD_CSV_HARD_MAX_MB=100
VGUARD_CSV_MAX_ARCHIVE_FILES=100
VGUARD_CSV_ALLOW_UNLIMITED=0

# DigitalOcean / KVM / Mininet lab evidence defaults
VGUARD_PUBLIC_IPV4=157.230.118.251
VGUARD_PRIVATE_IPV4=10.114.0.3
VGUARD_PUBLIC_IPV6=2a03:b0c0:3:f0:0:2:7de2:9000
VGUARD_PROVIDER=DigitalOcean
VGUARD_KVM_VM_NAME=vguard-kvm-test
VGUARD_KVM_GATEWAY=192.168.122.1
VGUARD_KVM_VM_IP=192.168.122.54
VGUARD_HONEYPOT_PORT=8081

# Keep disabled unless this is an isolated Linux lab host running the API as root.
VGUARD_ENABLE_LAB_RUN=0
# VGUARD_LAB_PYTHON=/root/V-Guard/.venv/bin/python
VGUARD_MININET_RUN_TIMEOUT=180
